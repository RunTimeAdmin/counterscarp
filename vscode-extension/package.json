{
  "name": "counterscarp-security",
  "displayName": "Counterscarp Security - Smart Contract Auditor",
  "description": "Real-time security analysis for Solidity contracts powered by Counterscarp Engine",
  "version": "1.0.0",
  "publisher": "CyberShieldAustin",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/RunTimeAdmin/counterscarp-engine"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "solidity",
    "ethereum",
    "security",
    "audit",
    "smart contracts",
    "blockchain"
  ],
  "activationEvents": [
    "onLanguage:solidity",
    "onCommand:counterscarp.analyze"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "counterscarp.analyze",
        "title": "Counterscarp: Analyze Contract"
      },
      {
        "command": "counterscarp.liarDetector",
        "title": "Counterscarp: Run Liar Detector"
      },
      {
        "command": "counterscarp.accessMatrix",
        "title": "Counterscarp: Show Access Matrix"
      }
    ],
    "configuration": {
      "title": "Counterscarp Security",
      "properties": {
        "counterscarp.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Path to Python interpreter"
        },
        "counterscarp.enginePath": {
          "type": "string",
          "default": "",
          "description": "Path to Counterscarp Engine installation"
        },
        "counterscarp.enableRealtime": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time analysis on file save"
        },
        "counterscarp.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API key for AI exploit generation (optional)"
        }
      }
    },
    "languages": [
      {
        "id": "solidity",
        "aliases": ["Solidity", "solidity"],
        "extensions": [".sol"],
        "configuration": "./language-configuration.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^4.9.0"
  },
  "dependencies": {
    "child_process": "^1.0.2"
  }
}
