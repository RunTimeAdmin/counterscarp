# Copy to .env.virtuals and fill in values:
#   cp .env.virtuals.example .env.virtuals

# Generate with:
#   python -c "import secrets; print('cs_' + secrets.token_urlsafe(32))"
COUNTERSCARP_AGENT_API_KEY=cs_change_me_in_production

# Session secret for the web app (dev default is fine for local Docker)
SESSION_SECRET=docker-dev-session-secret

# Host port for Counterscarp web API
WEB_PORT=8001

# Scan polling timeout (seconds) for the agent client
COUNTERSCARP_SCAN_TIMEOUT=600

# --- Required only for the full GAME agent (--profile agent) ---
# Get from https://console.game.virtuals.io/
GAME_API_KEY=

# Optional model override
# GAME_MODEL=Llama-3.3-70B-Instruct
