[Unit]
Description=Counterscarp Engine scan worker (arq)
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=exec
User=counterscarp
Group=counterscarp
WorkingDirectory=/opt/counterscarp-engine
ExecStart=/opt/counterscarp-engine/venv/bin/arq webapp.worker.WorkerSettings
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=COUNTERSCARP_UPLOAD_DIR=/opt/counterscarp-engine/uploads
Environment=COUNTERSCARP_RESULTS_DIR=/opt/counterscarp-engine/results
# npm needs a writable cache; the home directory is read-only below.
Environment=npm_config_cache=/opt/counterscarp-engine/.cache/npm
# Bound what one hostile submission can consume.
MemoryMax=4G
TasksMax=512

# --- Sandbox -----------------------------------------------------------------
# This process fetches, unpacks and compiles code submitted by strangers.
# The application never runs a project's own build tooling, but keep the
# worker boxed in anyway: it may write only its own directory, cannot see
# other users' processes (their command lines can hold secrets), and cannot
# gain privileges. Network stays on: git clone and npm need it.
# Check on the host with: systemd-analyze security counterscarp-worker
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=/opt/counterscarp-engine
ProtectHome=read-only
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
