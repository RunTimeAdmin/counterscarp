# =============================================================================
# Counterscarp Engine — Environment Variables
# =============================================================================
# Copy to .env and fill in values for your deployment.

# REQUIRED for production (COUNTERSCARP_ENV=production)
SESSION_SECRET=           # Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
STRIPE_SECRET_KEY=        # Stripe Dashboard > API Keys
STRIPE_WEBHOOK_SECRET=    # Stripe Dashboard > Webhooks > Signing secret
STRIPE_PUBLISHABLE_KEY=   # Stripe Dashboard > API Keys
ADMIN_EMAIL=              # Admin user email for /api/license/info access

# REQUIRED for Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=      # e.g., https://app.counterscarp.io/auth/google/callback

# OPTIONAL
COUNTERSCARP_ENV=production    # Set to "production" to enforce strict secret validation
SCARPSHIELD_PRO_LICENSE=       # Pro license key for engine features (preferred)
COUNTERSCARP_PRO_LICENSE=      # Legacy fallback env var (optional)
OPENAI_API_KEY=                # For AI copilot features
